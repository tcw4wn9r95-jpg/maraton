<?xml version="1.0" ?>
<workout_file>
    <author>Coach Claudio</author>
    <name>Cruise Intervals 5x8min</name>
    <description>Tempo pace broken into segments with short rest.</description>
    <sportType>run</sportType>
    <tags>
        <tag name="cruise_intervals"/>
        <tag name="intermediate"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.76"/>
        <IntervalsT Repeat="5" OnDuration="480" OffDuration="90" OnPower="0.92" OffPower="0.60"/>
        <Cooldown Duration="600" PowerLow="0.76" PowerHigh="0.55"/>
    </workout>
</workout_file>
