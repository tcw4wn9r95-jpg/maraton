<?xml version="1.0" ?>
<workout_file>
    <author>Coach Claudio</author>
    <name>Long Run 32km w/ 10km MP</name>
    <description>Long run finishing with 10km at marathon pace.</description>
    <sportType>run</sportType>
    <tags>
        <tag name="long_run_mp"/>
        <tag name="intermediate"/>
    </tags>
    <workout>
        <Warmup Duration="708" PowerLow="0.55" PowerHigh="0.76"/>
        <SteadyState Duration="6840" Power="0.74">
            <textevent timeoffset="0" message="Easy long-run pace"/>
        </SteadyState>
        <SteadyState Duration="3300" Power="0.84">
            <textevent timeoffset="0" message="Marathon goal pace"/>
        </SteadyState>
        <Cooldown Duration="354" PowerLow="0.76" PowerHigh="0.55"/>
    </workout>
</workout_file>
