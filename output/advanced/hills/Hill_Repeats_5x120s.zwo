<?xml version="1.0" ?>
<workout_file>
    <author>Coach Claudio</author>
    <name>Hill Repeats 5x120s</name>
    <description>Hard uphill, easy jog down. Builds strength and power.</description>
    <sportType>run</sportType>
    <tags>
        <tag name="hills"/>
        <tag name="advanced"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.76"/>
        <IntervalsT Repeat="5" OnDuration="120" OffDuration="150" OnPower="1.00" OffPower="0.60"/>
        <Cooldown Duration="600" PowerLow="0.76" PowerHigh="0.55"/>
    </workout>
</workout_file>
