<?xml version="1.0" ?>
<workout_file>
    <author>Coach Claudio</author>
    <name>Fartlek 12x1min</name>
    <description>Unstructured speed play. Fun and fast.</description>
    <sportType>run</sportType>
    <tags>
        <tag name="fartlek"/>
        <tag name="advanced"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.55" PowerHigh="0.76"/>
        <IntervalsT Repeat="12" OnDuration="60" OffDuration="60" OnPower="1.00" OffPower="0.71"/>
        <Cooldown Duration="600" PowerLow="0.76" PowerHigh="0.55"/>
    </workout>
</workout_file>
