<?xml version="1.0" ?>
<workout_file>
    <author>Coach Claudio</author>
    <name>Long Run 28km w/ 8km MP</name>
    <description>Long run finishing with 8km at marathon pace.</description>
    <sportType>run</sportType>
    <tags>
        <tag name="long_run_mp"/>
        <tag name="advanced"/>
    </tags>
    <workout>
        <Warmup Duration="612" PowerLow="0.55" PowerHigh="0.76"/>
        <SteadyState Duration="5355" Power="0.74">
            <textevent timeoffset="0" message="Easy long-run pace"/>
        </SteadyState>
        <SteadyState Duration="2112" Power="0.84">
            <textevent timeoffset="0" message="Marathon goal pace"/>
        </SteadyState>
        <Cooldown Duration="306" PowerLow="0.76" PowerHigh="0.55"/>
    </workout>
</workout_file>
